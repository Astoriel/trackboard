{
  "format_version": "trackboard.contract.v1",
  "plan_id": "plan_web",
  "version_id": "version_1",
  "version_number": 1,
  "name": "Web Analytics",
  "description": "Core product analytics contract",
  "published_at": "2026-06-27T12:00:00Z",
  "global_properties": [
    {
      "name": "user_id",
      "type": "string",
      "required": true,
      "constraints": {},
      "description": "Stable application user id",
      "examples": ["usr_123"]
    }
  ],
  "events": [
    {
      "event_name": "signup_completed",
      "status": "active",
      "description": "A user completes signup",
      "category": "activation",
      "implementation_guidance": {
        "trigger_when": [
          "Signup API returns success after the user account is persisted",
          "OAuth callback completes and the application session is created"
        ],
        "do_not_trigger_when": [
          "Signup form is submitted",
          "Client-side validation passes",
          "OAuth provider button is clicked"
        ],
        "preferred_location": "server",
        "required_source": "signup_api",
        "lifecycle_stage": "activation",
        "idempotency_key": "user_id",
        "privacy_notes": [
          "Do not include raw passwords.",
          "Do not include OAuth access or refresh tokens."
        ],
        "code_examples": [
          {
            "language": "typescript",
            "framework": "node",
            "snippet": "await trackSignupCompleted(client, { user_id, signup_method })"
          }
        ]
      },
      "properties": [
        {
          "name": "signup_method",
          "type": "string",
          "required": true,
          "constraints": {
            "enum_values": ["email", "google", "github"]
          },
          "description": "Signup method selected by the user",
          "examples": ["google"]
        }
      ],
      "global_properties": ["user_id"]
    }
  ]
}
