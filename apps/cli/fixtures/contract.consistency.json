{
  "format_version": "trackboard.contract.v1",
  "plan_id": "plan_consistency",
  "version_id": "version_1",
  "version_number": 1,
  "name": "Consistency Fixture",
  "global_properties": [
    {
      "name": "user_id",
      "type": "string",
      "required": true,
      "constraints": {},
