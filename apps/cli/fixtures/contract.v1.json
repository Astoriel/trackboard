{
  "format_version": "trackboard.contract.v1",
  "plan_id": "plan_1",
  "version_id": "version_1",
  "version_number": 1,
  "name": "Web Analytics",
  "description": "Core product events",
  "published_at": "2026-06-27T12:00:00Z",
  "global_properties": [
    {
      "name": "user_id",
      "type": "string",
      "required": true,
      "constraints": {},
      "description": "Stable user id",
      "examples": ["usr_123"]
    }
  ],
  "events": [
    {
      "event_name": "signup_completed",
      "status": "active",
      "description": "User completed signup",
      "category": "activation",
      "implementation_guidance": {
        "trigger_when": [
          "Signup API returns success and the user account is persisted"
        ],
        "do_not_trigger_when": [
          "Signup form is submitted",
          "Client-side validation passes"
        ],
        "preferred_location": "server",
        "required_source": "signup_api",
        "lifecycle_stage": "activation",
        "idempotency_key": "user_id",
        "privacy_notes": [
          "Do not include raw passwords or OAuth tokens"
        ],
        "code_examples": [
          {
            "language": "typescript",
            "framework": "node",
            "snippet": "await trackSignupCompleted(client, { user_id, signup_method })"
          }
        ]
      },
      "properties": [
        {
          "name": "signup_method",
          "type": "string",
          "required": true,
          "constraints": { "enum_values": ["email", "google", "github"] },
          "description": "Signup method",
          "examples": ["google"]
        }
      ],
      "global_properties": ["user_id"]
    }
  ]
}
